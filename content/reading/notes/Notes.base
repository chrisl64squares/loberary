views:
  - type: table
    name: Table
    filters:
      and:
        - type == "reading-note"
        - file.path.startsWith("reading/notes")
    order:
      - reading-date
      - book-title
      - book-author
      - book-pubdate
      - reading-rec
      - reading-status
    sort:
      - property: book-title
        direction: ASC
