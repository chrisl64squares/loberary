formulas:
  Untitled: link(file.name, note["book-title"])
properties:
  formula.Untitled:
    displayName: Title
  note.book-author:
    displayName: Author
  note.reading-date:
    displayName: Date Read
  note.book-pubdate:
    displayName: Pub Date
  note.reading-rec:
    displayName: Rec
  note.reading-status:
    displayName: Status
views:
  - type: table
    name: Table
    filters:
      and:
        - type == "reading-note"
        - file.path.startsWith("reading/notes")
    order:
      - reading-date
      - formula.Untitled
      - book-author
      - book-pubdate
      - reading-rec
      - reading-status
    sort:
      - property: reading-date
        direction: DESC
      - property: reading-status
        direction: ASC
    columnSize:
      formula.Untitled: 247
